Card random_card()
{
    return make_card(rand() % (KING   - ACE   + 1) + ACE,
                     rand() % (SPADES - CLUBS + 1) + CLUBS);
}

int sum(Card *hand)
{
    int sum = 0;

    for (Rank r; r = rank_of(*hand); hand++)
    {
        if (r == ACE)
            sum += sum > 10 ? 1 : 11;
        else
            sum += std::min(r, TEN);
    }

    return sum;
}

